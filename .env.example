# ===================================
# CLB Student Hub - Environment Config
# ===================================
# Copy to .env and customize for your environment

# --- Application ---
APP_ENV=development          # development, staging, production
APP_HOST=0.0.0.0
APP_PORT=9000
APP_RELOAD=true              # Enable auto-reload (dev only)

# --- Security ---
SECRET_KEY=your-super-secret-key-change-in-production-please-replace
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080   # 7 days

# --- Database ---
DATABASE_URL=sqlite:///./data/club_management.db
# For PostgreSQL: postgresql://user:password@db:5432/club_management

# --- Redis (for caching & rate limiting) ---
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

# --- CORS ---
BACKEND_CORS_ORIGINS=*
# For production: ["http://localhost:9000", "https://yourdomain.com"]

# --- AI / Ollama ---
# localhost khi chạy trực tiếp trên máy; host.docker.internal khi chạy trong container
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
AI_ENABLED=true

# Cloud AI providers (optional, for fallback when Ollama unavailable)
# Get keys at: https://console.anthropic.com/ and https://platform.openai.com/
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@ictu.edu.vn
SMTP_TLS=true

# --- Logging ---
LOG_LEVEL=INFO            # DEBUG, INFO, WARNING, ERROR

# --- File Upload ---
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
